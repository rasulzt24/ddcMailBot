# ===== Django =====
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Almaty

# ===== PostgreSQL =====
DB_NAME=mailddc
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ===== Telegram =====
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
# Ваш Telegram ID (узнать: @userinfobot) — суперадмин
SUPERADMIN_TELEGRAM_ID=0
REQUIRE_APPROVAL=True

# ===== Redis (FSM бота + события). Пусто = без Redis (опрос БД) =====
REDIS_URL=redis://:password@127.0.0.1:6379/0

# ===== Почтовый сервер =====
MAIL_IMAP_HOST=mail.nationalbank.kz
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=mail.nationalbank.kz
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURITY=starttls
MAIL_SSL_VERIFY=True
# Ключ шифрования паролей ящиков. НЕ МЕНЯТЬ после подключения ящиков (иначе пароли не расшифруются)
MAIL_ENCRYPTION_KEY=  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Доп. доверенные сертификаты Exchange (создать: python manage.py mail_trust_certs)
MAIL_SSL_CAFILE=certs/mail_trusted.pem
# Exchange отдаёт на SMTP сертификат с CN=EX-2 — имя не совпадает с хостом
MAIL_SMTP_CHECK_HOSTNAME=False
MAIL_POLL_INTERVAL=30
MAIL_INITIAL_IMPORT=30
# IMAP IDLE (Python 3.14+): мгновенные уведомления; плановый опрос тогда раз в N сек
MAIL_IDLE=True
MAIL_IDLE_POLL_INTERVAL=300
# Сверять «прочитано» с сервером (прочитали в Outlook — отметится в боте) за N дней. 0 — выключить
MAIL_READ_SYNC_DAYS=14

# ===== Хранилище файлов: пусто = локальный диск (media/), задано = MinIO/S3 =====
# S3_ENDPOINT_URL=http://127.0.0.1:9000   # SeaweedFS / любое S3-совместимое
# S3_BUCKET=mailbot
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_VERIFY_SSL=True
# Хранить оригиналы .eml (дублируют вложения, ~x2 места). False = качать с IMAP по запросу
MAIL_STORE_RAW=False
